# Dependencies, build products and generated projects
node_modules/
dist/
.build/
.swiftpm/
.vite/
coverage/
artifacts/
*.tsbuildinfo
/preview/vite.config.js
/preview/vite.config.d.ts
/ios/*.xcodeproj/

# Local browser profiles can contain cookies, history and credentials
.chrome-qa*/
.edge-qa*/
/preview/qa-*.png

# Credentials and local configuration
.env
.env.*
!.env.example
*.p8
*.p12
*.pfx
*.pem
*.key
*.mobileprovision

# Per-user IDE/OS data and temporary logs
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp

# Local design workspace: galleries, captures and review evidence stay on disk.
# Only the shared tokens and the brand source are part of the project.
/design/*
!/design/tokens.json
!/design/brand/

# Internal notes and working documents stay local; the repository keeps the
# design contract and the README screenshots.
/AGENTS.md
/PROGRESS.md
/RINGIFY_PROGRESS_REPORT.md
/docs/*
!/docs/NATIVE_APPLE_DESIGN.md
!/docs/screenshots/

# One-off scope checks and delivery helpers stay local.
/scripts/*
!/scripts/validate-native.sh
!/scripts/select-ios-simulator.mjs
!/scripts/select-ios-simulator.test.mjs
!/scripts/check-native-syntax.mjs
!/scripts/release-audit.mjs
!/scripts/sync-slot-catalog.mjs
/.github/workflows/native-diagnostics.yml
